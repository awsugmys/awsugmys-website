---
import '../styles/tokens.css';
import '../styles/global.css';
import SEO, { type SEOProps } from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { organizationSchema } from '../lib/structured-data';
import { amazonEmber } from '../lib/fonts';

interface Props extends SEOProps {
  jsonLd?: Record<string, unknown>[];
  /** AVIF srcsets of the hero background per theme, preloaded for the active theme. */
  heroPreload?: { day: string; night: string };
}

const { jsonLd = [], heroPreload, ...seo } = Astro.props;
const org = await organizationSchema();

const fonts = amazonEmber();
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Set theme before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        let t;
        try {
          t = localStorage.getItem('theme');
        } catch {
          /* storage blocked: fall back to OS preference */
        }
        if (t !== 'light' && t !== 'dark')
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        d.classList.add('js');
      })();
    </script>
    <meta name="theme-color" content="#ffffff" />
    {fonts.preload.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fonts.css} />
    {heroPreload && <script is:inline define:vars={{ hp: heroPreload }}>
      const l = document.createElement('link');
      l.rel = 'preload';
      l.as = 'image';
      l.type = 'image/avif';
      l.fetchPriority = 'high';
      l.setAttribute('imagesizes', '100vw');
      l.setAttribute(
        'imagesrcset',
        document.documentElement.dataset.theme === 'dark' ? hp.night : hp.day,
      );
      document.head.appendChild(l);
    </script>}
    <SEO {...seo} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="AWS User Group Mysuru blog"
      href={new URL('rss.xml', Astro.site).href}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd data={[org, ...jsonLd]} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
