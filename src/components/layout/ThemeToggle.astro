---
// Day/night toggle. The initial theme is set by the inline script in BaseLayout
// <head>; this button only flips and persists it.
---

<button
  class="theme-toggle"
  type="button"
  aria-label="Dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
    <g class="theme-toggle__sun">
      <circle cx="16" cy="16" r="6" fill="currentColor"></circle>
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M16 3.5v3M16 25.5v3M3.5 16h3M25.5 16h3M7.2 7.2l2.1 2.1M22.7 22.7l2.1 2.1M7.2 24.8l2.1-2.1M22.7 9.3l2.1-2.1"></path>
      </g>
    </g>
    <path
      class="theme-toggle__moon"
      d="M20.5 5.5a10.5 10.5 0 1 0 6 18.6A11.5 11.5 0 0 1 20.5 5.5z"
      fill="currentColor"
    ></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const media = matchMedia('(prefers-color-scheme: dark)');
  const COLOURS = { light: '#ffffff', dark: '#0f1b2a' } as const;
  type Theme = keyof typeof COLOURS;

  const stored = (): Theme | null => {
    try {
      const t = localStorage.getItem('theme');
      return t === 'light' || t === 'dark' ? t : null;
    } catch {
      return null;
    }
  };

  const apply = (theme: Theme) => {
    root.dataset.theme = theme;
    meta?.setAttribute('content', COLOURS[theme]);
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(theme === 'dark')));
  };

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode: theme still applies for this page view */
      }
    }),
  );

  // Follow OS changes until the visitor makes an explicit choice.
  media.addEventListener('change', (e) => {
    if (!stored()) apply(e.matches ? 'dark' : 'light');
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-heading);
    cursor: pointer;
    transition:
      box-shadow 0.2s,
      border-color 0.2s;
  }

  .theme-toggle:hover {
    border-color: var(--c-heading);
  }

  .theme-toggle svg {
    overflow: visible;
  }

  .theme-toggle__sun,
  .theme-toggle__moon {
    transform-origin: 16px 16px;
    transition:
      opacity 0.35s,
      transform 0.5s var(--ease-out);
  }

  .theme-toggle__sun {
    opacity: calc(1 - var(--night));
    transform: rotate(calc(var(--night) * 90deg)) scale(calc(1 - var(--night) * 0.5));
  }

  .theme-toggle__moon {
    opacity: var(--night);
    transform: scale(calc(0.5 + var(--night) * 0.5));
  }
</style>
