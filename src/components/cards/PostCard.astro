---
import { Image } from 'astro:assets';
import {
  featuredImage,
  formatDate,
  postUrl,
  readingTime,
  tagSlug,
  type Post,
} from '../../lib/content';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { post, headingLevel: H = 'h3', eager = false } = Astro.props;
const { data } = post;
const img = featuredImage(post);
const minutes = readingTime(post.body);
// Stable per-post colourway for the decorative art.
const tone = [...post.id].reduce((n, c) => n + c.charCodeAt(0), 0) % 3;
---

<article class="card card--interactive post-card" data-tone={tone}>
  <div class="post-card__art" aria-hidden="true">
    {img ? (
      <Image
        src={img}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 64rem) 22rem, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="post-card__img"
      />
    ) : (
      <span class="post-card__motif" />
    )}
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </p>
    <H class="post-card__title">
      <a class="card-link" href={postUrl(post)}>
        {data.title}
      </a>
    </H>
    <p class="post-card__desc">{data.description}</p>
    {data.tags.length > 0 && (
      <ul class="tag-list post-card__tags" aria-label="Tags">
        {data.tags.slice(0, 4).map((tag) => (
          <li>
            <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .post-card__art {
    --art-a: #232f3e;
    --art-b: #4a2a7a;
    position: relative;
    aspect-ratio: 16 / 7;
    background:
      radial-gradient(ellipse at 50% 120%, rgb(255 153 0 / 0.35), transparent 60%),
      linear-gradient(165deg, var(--art-a), var(--art-b));
    overflow: hidden;
  }

  .post-card[data-tone='1'] .post-card__art {
    --art-a: #0f2a44;
    --art-b: #232f3e;
  }

  .post-card[data-tone='2'] .post-card__art {
    --art-a: #2e1a52;
    --art-b: #0f2a44;
  }

  /* Palace skyline in AWS orange over a navy/purple gradient. */
  .post-card__motif {
    position: absolute;
    inset: 0;
    background: none;
  }

  .post-card__motif::after {
    content: '';
    position: absolute;
    inset: auto 8% -2px;
    aspect-ratio: 1000 / 340;
    background: linear-gradient(to top, #ff9900, #ffb84d);
    mask: url('/palace-silhouette.svg') center bottom / 100% auto no-repeat;
    opacity: 0.55;
  }

  .post-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--c-text-muted);
    font-size: var(--step--1);
  }

  .post-card__title {
    font-size: var(--step-1);
  }

  .post-card__desc {
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__tags {
    margin-top: auto;
    padding-top: var(--space-2);
  }
</style>
