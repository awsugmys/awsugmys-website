---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'>;
}

const { data } = Astro.props.member;
const words = data.name.split(/\s+/);
const initials = (words[0][0] + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase();
---

<article class="card card--interactive team-card">
  <div class="team-card__portrait" aria-hidden={data.photo ? undefined : 'true'}>
    {data.photo ? (
      <Image
        src={data.photo}
        alt={`Portrait of ${data.name}`}
        width={176}
        height={176}
        class="team-card__photo"
      />
    ) : (
      <span class="team-card__initials">{initials}</span>
    )}
  </div>
  <h3 class="team-card__name">
    {data.linkedin ? (
      <a class="card-link" href={data.linkedin} rel="noopener" target="_blank">
        {data.name}
        <span class="visually-hidden"> on LinkedIn (opens in a new tab)</span>
      </a>
    ) : (
      data.name
    )}
  </h3>
  <p class="team-card__role">{data.role}</p>
  {data.bio && <p class="team-card__bio">{data.bio}</p>}
  {data.linkedin && (
    <span class="team-card__social" aria-hidden="true">
      <Icon name="linkedin" size={16} /> LinkedIn
    </span>
  )}
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-5) var(--space-4);
    text-align: center;
  }

  .team-card__portrait {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--squid-ink), #5a2a8e);
    box-shadow:
      0 0 0 3px var(--c-surface),
      0 0 0 4px var(--c-border);
  }

  .team-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-card__initials {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .team-card__name {
    font-size: 1.05rem;
  }

  .team-card__role {
    margin-top: var(--space-1);
    color: var(--c-text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .team-card__bio {
    margin-top: var(--space-2);
    font-size: 0.95rem;
  }

  .team-card__social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
    color: var(--c-link);
    font-size: var(--step--1);
    font-weight: 600;
  }
</style>
