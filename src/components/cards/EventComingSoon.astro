---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';
---

<div class="card no-upcoming">
  <div class="no-upcoming__lamp" aria-hidden="true">
    <Icon name="calendar" size={30} />
  </div>
  <div>
    <h3>Next meetup: coming soon</h3>
    <p class="muted">
      We're lining up the next session. Join the Meetup group to be the first to know when
      registrations open.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href={SITE.meetupUrl} rel="noopener" target="_blank">
        <Icon name="meetup" /> Get notified on Meetup
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
      <a class="btn btn--ghost" href={SITE.speakerFormUrl} rel="noopener" target="_blank">
        <Icon name="mic" /> Propose a talk<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </div>
  </div>
</div>

<style>
  .no-upcoming {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    border-style: dashed;
  }

  .no-upcoming__lamp {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-arch);
    background: var(--c-bg-alt);
    color: var(--c-accent-text);
  }

  .no-upcoming h3 {
    font-size: var(--step-1);
  }

  .no-upcoming p {
    margin-block: var(--space-2) var(--space-4);
  }

  @media (max-width: 30rem) {
    .no-upcoming {
      grid-template-columns: 1fr;
    }
  }
</style>
