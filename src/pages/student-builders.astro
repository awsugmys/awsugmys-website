---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../data/site';

const PROGRAM_URL = 'https://builder.aws.com/community/student-builder-groups';

const groups = (await getCollection('studentGroups'))
  .map((g) => g.data)
  .sort((a, b) => a.order - b.order);

const FACTS = [
  {
    icon: 'users',
    title: 'Student-led',
    text: 'Each group is run by Student Builder Group Leaders on campus, with support from AWS.',
  },
  {
    icon: 'cap',
    title: 'Open to students',
    text: 'Membership is open to learners aged 18+ enrolled at a post-secondary institution.',
  },
  {
    icon: 'book',
    title: 'Learn by building',
    text: 'Technical events, workshops and hands-on projects to grow real cloud and AI skills.',
  },
] as const;
---

<BaseLayout
  title="Student Builders"
  description="AWS Student Builder Groups in and around Mysuru: student-led cloud communities at VVCE, MUSE, MIT Thandavapura and GMIT, and how to join or start one."
>
  <header class="page-hero container">
    <span class="eyebrow">Students</span>
    <h1>Student Builders</h1>
    <p>
      AWS Student Builder Groups are student-led cloud communities on campuses across the Mysuru
      region. Find the group on your campus and join it on Meetup, or start one.
    </p>
  </header>

  <Section id="groups" eyebrow="Find your group" title="Student groups in and around Mysuru">
    <ul class="group-grid">
      {groups.map((g) => (
        <li class="card card--interactive group">
          <span class="group__icon">
            <Icon name="cap" size={22} />
          </span>
          <h3 class="group__name">
            <a class="card-link" href={g.meetupUrl} rel="noopener" target="_blank">
              {g.institution}
              <span class="visually-hidden"> ({g.name} on Meetup, opens in a new tab)</span>
            </a>
          </h3>
          <p class="group__meta">
            <Icon name="pin" size={15} />
            {g.location}
          </p>
          {g.leader && (
            <p class="group__meta">
              <Icon name="users" size={15} />
              Led by {g.leader}
            </p>
          )}
          <span class="group__join" aria-hidden="true">
            <Icon name="meetup" size={16} /> Join on Meetup
          </span>
        </li>
      ))}
    </ul>
    <p class="source muted">
      Is your campus group missing? <a href={`mailto:${SITE.email}`}>Let us know</a>.
    </p>
  </Section>

  <Section
    id="programme"
    tone="alt"
    eyebrow="The programme"
    title="About AWS Student Builder Groups"
  >
    <p class="lead">
      AWS Student Builder Groups (formerly AWS Cloud Clubs) bring students together to explore cloud
      technology, build projects and grow their technical skills, on their own campus.
    </p>
    <ul class="facts">
      {FACTS.map((f) => (
        <li class="card fact">
          <span class="group__icon">
            <Icon name={f.icon} size={22} />
          </span>
          <h3>{f.title}</h3>
          <p class="muted">{f.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="start" title="No group on your campus yet?">
    <p class="lead">
      Any eligible student can apply to start an AWS Student Builder Group and become its leader.
      AWS User Group Mysuru runs hands-on workshops for students across the region, and student
      builders are always welcome at our meetups.
    </p>
    <div class="btn-row start__ctas">
      <a class="btn btn--primary" href={PROGRAM_URL} rel="noopener" target="_blank">
        Start a group on AWS Builder Center
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
      <a class="btn btn--ghost" href="/events/">
        <Icon name="calendar" /> See our events
      </a>
    </div>
  </Section>
</BaseLayout>

<style>
  .lead {
    max-width: 44rem;
    font-size: var(--step-1);
  }

  .group-grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .group__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg-alt);
    color: var(--c-accent-text);
  }

  .group__name {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .group__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-text-muted);
    font-size: var(--step--1);
  }

  .group__meta :global(svg) {
    flex: none;
    color: var(--c-accent-text);
  }

  .group__join {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--c-link);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .source {
    margin-top: var(--space-5);
    font-size: var(--step--1);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .fact {
    padding: var(--space-5);
  }

  .fact h3 {
    margin-top: var(--space-1);
    font-size: 1.1rem;
  }

  .fact p {
    margin-top: var(--space-1);
  }

  .start__ctas {
    margin-top: var(--space-5);
  }
</style>
