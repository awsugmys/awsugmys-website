---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../lib/content';

const tags = await getTags();
---

<BaseLayout title="Tags" description="Browse AWS User Group Mysuru blog posts by topic.">
  <header class="page-hero container">
    <span class="eyebrow">Blog</span>
    <h1>All tags</h1>
  </header>
  <div class="container--narrow">
    <ul class="tag-list tag-cloud">
      {tags.map((t) => (
        <li>
          <a class="tag" href={`/tags/${t.slug}/`}>
            #{t.tag} <span aria-hidden="true">· {t.count}</span>
            <span class="visually-hidden">({t.count} posts)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    justify-content: center;
    gap: var(--space-3);
  }

  .tag-cloud .tag {
    padding: 0.35rem 0.9rem;
    font-size: var(--step-0);
  }
</style>
