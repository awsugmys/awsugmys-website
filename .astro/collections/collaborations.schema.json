{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "default": "event",
      "type": "string",
      "enum": [
        "event",
        "organization",
        "community"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "year": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "location": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "logo": {
      "type": "string"
    },
    "blurb": {
      "type": "string"
    },
    "order": {
      "default": 99,
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}