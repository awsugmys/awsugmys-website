{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "startTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "endTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "format": {
      "default": "in-person",
      "type": "string",
      "enum": [
        "in-person",
        "online",
        "hybrid"
      ]
    },
    "venue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "city"
      ]
    },
    "speakers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "description": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "registrationUrl": {
      "type": "string",
      "format": "uri"
    },
    "alternateUrl": {
      "type": "string",
      "format": "uri"
    },
    "slidesUrl": {
      "type": "string",
      "format": "uri"
    },
    "materialsUrl": {
      "type": "string",
      "format": "uri"
    },
    "recordingUrl": {
      "type": "string",
      "format": "uri"
    },
    "blogPost": {
      "type": "string"
    },
    "placeholder": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "description"
  ]
}