# Copy to terraform.tfvars and adjust. All values shown are the defaults.

domain_name = "awsugmys.in"
include_www = true
aws_region  = "ap-south-1"

# Leave empty to use "<domain>-site-<account id>".
bucket_name = ""

# PriceClass_200 includes edge locations in India.
price_class = "PriceClass_200"

github_repository  = "awsugmys/awsugmys-website"
github_environment = "production"

# Set to false if this AWS account already has the GitHub OIDC provider.
create_github_oidc_provider = true

# Set to true only if the hosted zone already has A/AAAA records for the domain
# (e.g. an old site) that should be replaced.
overwrite_existing_dns_records = false

force_destroy_bucket = false
