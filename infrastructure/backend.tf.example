# Optional: keep Terraform state in S3 instead of on one laptop.
# 1. Create a private, versioned S3 bucket for state in the target account.
# 2. Copy this file to backend.tf, fill in the bucket name, and run: terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "REPLACE-WITH-STATE-BUCKET"
    key          = "awsugmys-website/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true # native S3 state locking (Terraform 1.10+)
  }
}
